# =============================================================================
# Glottolog worker — local secrets (NE PAS COMMITTER le fichier .env)
# =============================================================================
# Setup (une fois) :
#   cp scripts/glottolog_worker/.env.example scripts/glottolog_worker/.env
#
# Remplis UNIQUEMENT les 2 lignes marquées ← TOI :
#   1) ton adresse Gmail
#   2) un mot de passe d'application Google (16 caractères)
#
# Créer l'App Password :
#   Google Account → Sécurité → Validation en 2 étapes (obligatoire)
#   → Mots de passe des applications → Mail → générer
#   Coller les 16 caractères ci-dessous (espaces OK)
#
# Dans l'admin Vignette (Schedule) : mets aussi ton email comme
# "Notification email" (destinataire des alertes après chaque update).
# =============================================================================

GLOTTOLOG_SMTP_PROVIDER=gmail
GLOTTOLOG_SMTP_HOST=smtp.gmail.com
GLOTTOLOG_SMTP_PORT=587
GLOTTOLOG_SMTP_STARTTLS=true

# ← TOI : ton Gmail (même valeur pour USER et FROM)
GLOTTOLOG_SMTP_USER=ton.adresse@gmail.com
GLOTTOLOG_SMTP_FROM=ton.adresse@gmail.com

# ← TOI : App Password Google (PAS le mot de passe du compte)
GLOTTOLOG_SMTP_PASSWORD=xxxx xxxx xxxx xxxx

# Optionnel — DB (défauts = profil Java pgdev local)
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=vignette
# PGUSER=vignette
# PGPASSWORD=
